# Kopyalayıp .env olarak kaydedin: cp .env.example .env

# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=en-az-32-karakterlik-rastgele-bir-deger-uretin
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Boş bırakılırsa SQLite (backend/db.sqlite3) kullanılır.
# PostgreSQL örneği: postgres://kullanici:sifre@localhost:5432/staj
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Belge okuyucu: pdf (metin katmanlı Ek-16) | mock (yalnızca test, dosyaya bakmaz) | gemini (final)
DOCUMENT_READER=pdf
GEMINI_API_KEY=

# Staj kuralları
INTERNSHIP_MIN_WORK_DAYS=20
# Formun staj başlangıcından en az kaç gün önce teslim edilmesi gerektiği
INTERNSHIP_MIN_DAYS_BEFORE_START=30
# Dini bayramlar gibi yıla göre değişen tatiller (YYYY-AA-GG, virgülle)
INTERNSHIP_EXTRA_HOLIDAYS=

# Yükleme sınırı (MB)
DOCUMENT_MAX_UPLOAD_MB=10
